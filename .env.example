# Copy to .env.local for local work. On Cloudflare Pages set these under Settings > Variables and secrets (Production).
NEXT_PUBLIC_API_URL=https://YOUR-API.vercel.app      # the Vercel URL (or api.masfig.com) of masfig-api, no trailing slash
NEXT_PUBLIC_SITE_URL=https://masfig.com
# Tracking IDs (Google Analytics, Meta Pixel, Search Console...) are NOT set here: add them in Admin > Tracking.
# ALLOW_STATIC_FALLBACK=1                            # LOCAL ONLY: lets the build run without the API. Never set on Cloudflare.
